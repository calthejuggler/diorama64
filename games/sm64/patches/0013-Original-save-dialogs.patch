diff --git a/src/game/save_file.c b/src/game/save_file.c
index 061ef00..627fddb 100644
--- a/src/game/save_file.c
+++ b/src/game/save_file.c
@@ -43,13 +43,8 @@ s8 gSaveFileModified;
 
 u8 gLastCompletedCourseNum = COURSE_NONE;
 u8 gLastCompletedStarNum = 0;
-u32 gArAutoSaveCount;
-u8 gArAutoSaveCourse, gArAutoSaveStar;
-void ar_note_auto_save(void) {
-    gArAutoSaveCourse = gLastCompletedCourseNum;
-    gArAutoSaveStar = gLastCompletedStarNum;
-    gArAutoSaveCount++;
-}
+u32 gArSaveCount;
+u8 gArSaveCourse, gArSaveStar;
 s8 sUnusedGotGlobalCoinHiScore = 0;
 u8 gGotFileCoinHiScore = FALSE;
 u8 gCurrCourseStarFlags = 0;
@@ -414,6 +409,9 @@ static void save_file_bswap(struct SaveBuffer *buf) {
 
 void save_file_do_save(s32 fileIndex, s8 forceSave) {
     if (INVALID_FILE_INDEX(fileIndex)) { return; }
+    gArSaveCount++;   /* AR: bookkeeping only (the host logs it) */
+    gArSaveCourse = gLastCompletedCourseNum;
+    gArSaveStar = gLastCompletedStarNum;
     if (gNetworkType != NT_SERVER) {
         if (gNetworkType == NT_CLIENT) { network_send_save_file(fileIndex); return; }
         else if (gNetworkType == NT_NONE && !forceSave) { return; }
