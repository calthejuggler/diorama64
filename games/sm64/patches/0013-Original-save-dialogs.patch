@@ -1016,7 +1014,6 @@ u32 interact_star_or_key(struct MarioState *m, UNUSED u32 interactType, struct O
             return set_mario_action(m, ACT_JUMBO_STAR_CUTSCENE, 0);
         }
         save_file_do_save(gCurrSaveFileNum - 1, TRUE);
-        if (gArMode) { ar_note_auto_save(); }
 
         if (noExit && gServerSettings.stayInLevelAfterStar == STAR_NON_STOP) {
             return TRUE;
