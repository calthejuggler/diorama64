diff --git a/src/game/ar_game_hooks.h b/src/game/ar_game_hooks.h
index e69de29..ee452a4 100644
--- a/src/game/ar_game_hooks.h
+++ b/src/game/ar_game_hooks.h
@@ -0,0 +1,20 @@
+#ifndef AR_GAME_HOOKS_H
+#define AR_GAME_HOOKS_H
+/* AR game-side seams. The table is NULL by default and every call site also requires
+ * gArMode, so with gArMode == false the game behaves exactly like upstream. The host (AR adapter) fills it. */
+#include <PR/ultratypes.h>
+#include "pc/gfx/gfx_ar_hooks.h"
+struct MarioState;
+struct ArGameHooks {
+    /* Yaw in camera->yaw convention (from Mario toward the viewer) for the stick, pole and star-dance facing. */
+    s16 (*control_yaw)(struct MarioState *m);
+    /* Billboard (cylinder == 0) or cylboard matrix facing the viewer's head; replaces mtxf_billboard/mtxf_cylboard. */
+    void (*billboard)(f32 dest[4][4], f32 mtx[4][4], f32 position[3], s32 cylinder);
+    /* Listener-space vector of a level-space point (the head is the listener); replaces cameraToObject = view * pos.
+     * levelPos is gMatStack[gMatStackIndex][3], which is level space only because ar_camera_lookat
+     * (rendering_graph_node.c) makes the view the identity in AR mode; if that changes, pass a level-space point. */
+    void (*listener_vector)(f32 out[3], f32 levelPos[3]);
+};
+extern struct ArGameHooks *gArGameHooks;
+#define AR_GAME_HOOK(name) (gArMode && gArGameHooks != NULL && gArGameHooks->name != NULL)
+#endif
