+/* AR: the viewer is not Lakitu. World geometry is emitted in level space (identity view) while the
+ * camera node still runs, so cutscenes and camera-driven game logic behave as in the original. */
+static void ar_camera_lookat(Mat4 m, Vec3f pos, Vec3f focus, s16 roll) {
+    if (gArMode) { mtxf_identity(m); } else { mtxf_lookat(m, pos, focus, roll); }
+}
+
+/* AR: billboards face the viewer's head, not the hidden Lakitu's screen plane. */
+static void ar_billboard(Mat4 dest, Mat4 mtx, Vec3f pos, s16 roll, s32 cylinder) {
+    if (AR_GAME_HOOK(billboard)) {
+        gArGameHooks->billboard(dest, mtx, pos, cylinder);
+    } else if (cylinder) {
+        mtxf_cylboard(dest, mtx, pos, roll);
+    } else {
+        mtxf_billboard(dest, mtx, pos, roll);
+    }
+}
+
