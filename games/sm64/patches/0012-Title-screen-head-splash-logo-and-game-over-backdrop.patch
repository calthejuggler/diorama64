 // data
 static s32 D_801A82D0 = 0;
@@ -130,6 +133,123 @@ void grabbable_joint_update_func(struct ObjJoint *self) {
     }
 }
 
+/* AR: eye follow (ar_goddard.h). gd's eye maths below are vanilla's; the follow only lets them run
+ * outside the still pose, where the face is as in it (ar_goddard_eyes_still_at). The rest records what they did, for tests. */
+static s32 sArEyeFollow;
+static struct ObjJoint *sArEyeJ[2];
+static f32 sArEyeAt[2][3], sArEyeScr[2][2], sArEyeOff[2][2];
+static u32 sArEyeCount, sArEyeStillSkips;
+static f32 sArEyeFrame;
+void ar_goddard_set_eye_follow(s32 on) { sArEyeFollow = on; }
+static s32 ar_eye_slot(struct ObjJoint *j) {
+    if (sArEyeJ[0] == j) { return 0; }
+    if (sArEyeJ[1] == j) { return 1; }
+    if (sArEyeJ[0] == NULL) { sArEyeJ[0] = j; return 0; }
+    if (sArEyeJ[1] == NULL) { sArEyeJ[1] = j; return 1; }
+    sArEyeJ[0] = j; sArEyeJ[1] = NULL;
+    return 0;
+}
+/* the face is still at a keyframe of the head's normal animation when it is as in vanilla's still pose (frame
+ * 660, where state 7 holds the head; rotations in the animations' 0.1 degree units): both lids at most AR_EYE_LID_SLACK
+ * more closed (they close by rotating up their z), both eyes' own animated look within AR_EYE_LOOK_SLACK, the head
+ * within AR_EYE_HEAD_ROT_SLACK and AR_EYE_HEAD_POS_SLACK gd units, at that keyframe and the next (move_animator blends
+ * toward it; the last's next is the first). The follow runs on still keyframes in runs of at least AR_EYE_STILL_RUN (no twitch). */
+#define AR_EYE_STILL_FRAME 660
+#define AR_EYE_LID_SLACK 20
+#define AR_EYE_LOOK_SLACK 60
+#define AR_EYE_HEAD_ROT_SLACK 200
+#define AR_EYE_HEAD_POS_SLACK 100
+#define AR_EYE_STILL_RUN 15
+#define AR_EYE_STILL_MAX 1024
+static s32 ar_eye_anim_ok(struct AnimDataInfo *a, s32 type, s32 stride) {
+    return a[0].type == type && a[0].data != NULL && a[0].count >= AR_EYE_STILL_FRAME && a[0].count < AR_EYE_STILL_MAX;
+}
+static s32 ar_eye_dev(struct AnimDataInfo *a, s32 stride, s32 f, s32 k0, s32 n, s32 up) {
+    s16 *d = (s16 *) a[0].data;
+    s32 k, m = 0, v;
+    for (k = k0; k < k0 + n; k++) {
+        v = d[(f - 1) * stride + k] - d[(AR_EYE_STILL_FRAME - 1) * stride + k];
+        if (!up && v < 0) { v = -v; }
+        if (v > m) { m = v; }
+    }
+    return m;
+}
+static s32 ar_eye_pose_ok(s32 f) {
+    return ar_eye_dev(anim_mario_eyelid_left, 3, f, 2, 1, TRUE) <= AR_EYE_LID_SLACK
+           && ar_eye_dev(anim_mario_eyelid_right, 3, f, 2, 1, TRUE) <= AR_EYE_LID_SLACK
+           && ar_eye_dev(anim_mario_eye_left, 3, f, 0, 3, FALSE) <= AR_EYE_LOOK_SLACK
+           && ar_eye_dev(anim_mario_eye_right, 3, f, 0, 3, FALSE) <= AR_EYE_LOOK_SLACK
+           && ar_eye_dev(anim_mario_intro, 6, f, 0, 3, FALSE) <= AR_EYE_HEAD_ROT_SLACK
+           && ar_eye_dev(anim_mario_intro, 6, f, 3, 3, FALSE) <= AR_EYE_HEAD_POS_SLACK;
+}
+static u8 sArEyeStill[AR_EYE_STILL_MAX], sArEyePose[AR_EYE_STILL_MAX];
+static s32 sArEyeStillN;
+static s32 sArEyeStillStatus;
+/* pose[f], out[f] for f in 1..n: out[f] = pose[f] and pose of the next keyframe (n's next is 1: move_animator wraps),
+ * then runs shorter than run dropped */
+void ar_goddard_still_mask(const u8 *pose, s32 n, s32 run, u8 *out) {
+    s32 f, g, k;
+    for (f = 1; f <= n; f++) { out[f] = pose[f] && pose[f == n ? 1 : f + 1]; }
+    for (f = 1; f <= n; f = g) {
+        for (g = f; g <= n && out[g] == out[f]; g++) { }
+        if (out[f] && g - f < run) { for (k = f; k < g; k++) { out[k] = 0; } }
+    }
+}
+static void ar_eye_still_make(void) {
+    s32 n = anim_mario_eyelid_left[0].count, f;
+    sArEyeStillStatus = -1;
+    if (!ar_eye_anim_ok(anim_mario_eyelid_left, GD_ANIM_ROT3S, 3) || !ar_eye_anim_ok(anim_mario_eyelid_right, GD_ANIM_ROT3S, 3)
+        || !ar_eye_anim_ok(anim_mario_eye_left, GD_ANIM_ROT3S, 3) || !ar_eye_anim_ok(anim_mario_eye_right, GD_ANIM_ROT3S, 3)
+        || !ar_eye_anim_ok(anim_mario_intro, GD_ANIM_ROT3S_POS3S, 6)) { return; }
+    if (anim_mario_eyelid_right[0].count < n) { n = anim_mario_eyelid_right[0].count; }
+    if (anim_mario_eye_left[0].count < n) { n = anim_mario_eye_left[0].count; }
+    if (anim_mario_eye_right[0].count < n) { n = anim_mario_eye_right[0].count; }
+    if (anim_mario_intro[0].count < n) { n = anim_mario_intro[0].count; }
+    /* the still pose's lid is never at 0 once the ROM's animations are loaded (retried: -1 until then) */
+    if (((s16 *) anim_mario_eyelid_left[0].data)[(AR_EYE_STILL_FRAME - 1) * 3 + 2] == 0) { return; }
+    for (f = 1; f <= n; f++) { sArEyePose[f] = ar_eye_pose_ok(f); }
+    ar_goddard_still_mask(sArEyePose, n, AR_EYE_STILL_RUN, sArEyeStill);
+    sArEyeStillN = n; sArEyeStillStatus = 1;
+}
+s32 ar_goddard_eyes_still_status(void) {
+    if (sArEyeStillN == 0) { ar_eye_still_make(); }
+    return sArEyeStillStatus;
+}
+s32 ar_goddard_eyes_still_at(f32 frame) {
+    s32 f = (s32) frame;   /* the keyframe move_animator draws */
+    if (sArEyeStillN == 0) { ar_eye_still_make(); }
+    return sArEyeStillN > 0 && f >= 1 && f <= sArEyeStillN && sArEyeStill[f];
+}
+u32 ar_goddard_eye_offset(f32 out[2]) {
+    if (sArEyeCount == 0) { return 0; }
+    if (sArEyeJ[1] == NULL) { out[0] = sArEyeOff[0][0]; out[1] = sArEyeOff[0][1]; return sArEyeCount; }
+    out[0] = 0.5f * (sArEyeOff[0][0] + sArEyeOff[1][0]); out[1] = 0.5f * (sArEyeOff[0][1] + sArEyeOff[1][1]);
+    return sArEyeCount;
+}
+static s32 ar_eye_left(void) { return sArEyeScr[0][0] <= sArEyeScr[1][0] ? 0 : 1; }
+u32 ar_goddard_eye_offsets(f32 left[2], f32 right[2]) {
+    s32 l;
+    if (sArEyeCount == 0 || sArEyeJ[1] == NULL) { return 0; }
+    l = ar_eye_left();
+    left[0] = sArEyeOff[l][0]; left[1] = sArEyeOff[l][1]; right[0] = sArEyeOff[1 - l][0]; right[1] = sArEyeOff[1 - l][1];
+    return sArEyeCount;
+}
+u32 ar_goddard_eye_screens(f32 left[2], f32 right[2]) {
+    s32 l;
+    if (sArEyeCount == 0 || sArEyeJ[1] == NULL) { return 0; }
+    l = ar_eye_left();
+    left[0] = sArEyeScr[l][0]; left[1] = sArEyeScr[l][1]; right[0] = sArEyeScr[1 - l][0]; right[1] = sArEyeScr[1 - l][1];
+    return sArEyeCount;
+}
+s32 ar_goddard_eyes_world(f32 out[3]) {
+    s32 k;
+    if (sArEyeCount == 0 || sArEyeJ[1] == NULL) { return 0; }
+    for (k = 0; k < 3; k++) { out[k] = 0.5f * (sArEyeAt[0][k] + sArEyeAt[1][k]); }
+    return 1;
+}
+f32 ar_goddard_eye_frame(void) { return sArEyeFrame; }
+u32 ar_goddard_eye_still_skips(void) { return sArEyeStillSkips; }
+
 /**
  * Update function for Mario's eye joints, which makes them follow the cursor
  */
@@ -147,8 +267,17 @@ void eye_joint_update_func(struct ObjJoint *self) {
 
     if (self->rootAnimator != NULL) {
         if (self->rootAnimator->state != 7) {
-            return;
+            /* AR: with eye follow, also in the head's normal animation, where its face is still */
+            if (!sArEyeFollow || self->rootAnimator->controlFunc != animate_mario_head_normal
+                || self->rootAnimator->animSeqNum != 0) {
+                return;
+            }
+            if (!ar_goddard_eyes_still_at(self->rootAnimator->frame)) {
+                sArEyeStillSkips++;
+                return;
+            }
         }
+        sArEyeFrame = self->rootAnimator->frame;
     }
 
     set_cur_dynobj((struct GdObj *)self);
@@ -156,6 +285,10 @@ void eye_joint_update_func(struct ObjJoint *self) {
     sp44.x = (*sp5C)[3][0];
     sp44.y = (*sp5C)[3][1];
     sp44.z = (*sp5C)[3][2];
+    {
+        s32 slot = ar_eye_slot(self);
+        sArEyeAt[slot][0] = sp44.x; sArEyeAt[slot][1] = sp44.y; sArEyeAt[slot][2] = sp44.z;
+    }
     world_pos_to_screen_coords(&sp44, sCurrentMoveCamera, sCurrentMoveView);
 
     sp50.x = gGdCtrl.csrX - sp44.x;
@@ -171,6 +304,11 @@ void eye_joint_update_func(struct ObjJoint *self) {
         sp50.y *= 30.0f;
         sp50.z *= 30.0f;
     }
+    {
+        s32 slot = sArEyeJ[0] == self ? 0 : 1;
+        sArEyeScr[slot][0] = sp44.x; sArEyeScr[slot][1] = sp44.y;
+        sArEyeOff[slot][0] = sp50.x; sArEyeOff[slot][1] = sp50.y; sArEyeCount++;
+    }
 
     for (att = self->attachedObjsGrp->firstMember; att != NULL; att = att->next) {
         attobj = att->obj;
