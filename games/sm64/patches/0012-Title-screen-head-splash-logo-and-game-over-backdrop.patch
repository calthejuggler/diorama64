     sMHeadMainDls[gGdFrameBufNum]->curGfxIdx = 0;
     sCurrentGdDl = sDynamicMainDls[gGdFrameBufNum];
     sCurrentGdDl->curVtxIdx = 0;
@@ -1681,6 +1687,18 @@ void gd_dl_mul_trans_matrix(f32 x, f32 y, f32 z) {
     next_mtx();
 }
 
+s32 gd_dl_ar_space(s32 space, s32 reserve) {   /* AR: only called inside a gArMode gate */
+    /* A tag that leaves WORLD books itself and the restore after it in this frame's budget: the frame's tags never
+     * exceed GD_AR_TAG_BUDGET, the extra room the dynamic lists have with gArMode, so they can never make vanilla's own
+     * next_gfx overflow (vanilla fits in 600). Past the budget the tags are skipped (the shape draws as before). */
+    const s32 cost = space == GFX_AR_SPACE_WORLD ? 0 : 2;
+    if (sCurrentGdDl == NULL || sCurrentGdDl->curGfxIdx + 1 + reserve > sCurrentGdDl->totalGfx ||
+        sArGdTags + cost > GD_AR_TAG_BUDGET) { return 0; }
+    sArGdTags += cost;
+    gDPNoOpTag(next_gfx(), GFX_AR_TAG(GFX_AR_TAG_SPACE, space));
+    return 1;
+}
