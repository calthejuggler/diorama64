+    return 1;
+}
+s32 ar_goddard_cursor_to_world(f32 out[3]) {
+    struct ObjCamera *cam = ar_mscene_cam();
+    struct GdVec3f o, w;
+    Mat4f inv;
+    if (cam == NULL) { return 0; }
+    o.x = 0.0f; o.y = 0.0f; o.z = 0.0f;
+    gd_rotate_and_translate_vec3f(&o, &cam->unkE8);
+    if (o.z > -256.0f) { return 0; }
+    w.x = (gGdCtrl.csrX - ar_view_half(0)) * -o.z / 256.0f;       /* the inverse of world_pos_to_screen_coords */
+    w.y = (gGdCtrl.csrY - ar_view_half(1)) * o.z / 256.0f;
+    w.z = o.z;
+    gd_inverse_mat4f(&cam->unkE8, &inv);
+    gd_rotate_and_translate_vec3f(&w, &inv);
+    out[0] = w.x; out[1] = w.y; out[2] = w.z;
+    return 1;
+}
+s32 ar_goddard_camera_forward(f32 out[3]) {   /* camera space looks down -z (world_pos_to_screen_coords) */
+    struct ObjCamera *cam = ar_mscene_cam();
+    struct GdVec3f o, f;
+    Mat4f inv;
+    f32 n;
+    if (cam == NULL) { return 0; }
+    gd_inverse_mat4f(&cam->unkE8, &inv);
+    o.x = 0.0f; o.y = 0.0f; o.z = 0.0f;
+    f.x = 0.0f; f.y = 0.0f; f.z = -1.0f;
+    gd_rotate_and_translate_vec3f(&o, &inv);
+    gd_rotate_and_translate_vec3f(&f, &inv);
+    out[0] = f.x - o.x; out[1] = f.y - o.y; out[2] = f.z - o.z;
+    n = sqrtf(out[0] * out[0] + out[1] * out[1] + out[2] * out[2]);
+    if (!(n > 1e-6f)) { return 0; }
+    out[0] /= n; out[1] /= n; out[2] /= n;
+    return 1;
+}
