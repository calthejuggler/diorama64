diff --git a/src/goddard/joints.c b/src/goddard/joints.c
index 0863118..27a9279 100644
--- a/src/goddard/joints.c
+++ b/src/goddard/joints.c
@@ -18,6 +18,9 @@
 #include "sfx.h"
