diff --git a/src/goddard/ar_goddard.h b/src/goddard/ar_goddard.h
index e69de29..3445603 100644
--- a/src/goddard/ar_goddard.h
+++ b/src/goddard/ar_goddard.h
@@ -0,0 +1,28 @@
+#ifndef AR_GODDARD_H
+#define AR_GODDARD_H
+/* AR seams for pinch input on the title head. Plain floats: no gd types cross. gd's cursor is gGdCtrl.csrX/Y in its
+ * 320x240 view pixels; world points are Goddard world units (what the head's WORLD draws are in). */
+#include <PR/ultratypes.h>
+s32  ar_goddard_world_to_cursor(const f32 p[3], f32 out[2]);   /* as check_grabable_click projects a grab point; 0: no camera or behind it */
+s32  ar_goddard_cursor_to_world(f32 out[3]);                    /* the cursor's ray at the depth of gd's world origin; 0: no camera */
+s32  ar_goddard_camera_forward(f32 out[3]);
+void ar_goddard_set_cursor(f32 x, f32 y);
+void ar_goddard_get_cursor(f32 out[2]);
+/* with eye follow on, gd's eye maths (vanilla's: each eye from its own screen place, 2 x (cursor -
+ * eye), capped at 30) also run in the head's normal animation (vanilla: only its still pose after a grab, state 7; never
+ * the game-over head's dizzy spell), and there only where the face is as in that still pose (ar_goddard_eyes_still_at).
+ * Off: vanilla. */
+void ar_goddard_set_eye_follow(s32 on);
+/* at this frame of the head's normal animation the face is as in vanilla's still pose (frame 660): both lids
+ * at most 2 degrees more closed, both eyes' own look within 6 degrees, the head within 20 degrees and 100 units, at it and
+ * the next keyframe; in runs of at least 15 keyframes */
+s32  ar_goddard_eyes_still_at(f32 frame);
+s32  ar_goddard_eyes_still_status(void);
+void ar_goddard_still_mask(const u8 *pose, s32 n, s32 run, u8 *out);
+u32  ar_goddard_eye_offsets(f32 left[2], f32 right[2]);
+u32  ar_goddard_eye_screens(f32 left[2], f32 right[2]);
+u32  ar_goddard_eye_offset(f32 out[2]);
+s32  ar_goddard_eyes_world(f32 out[3]);
+f32  ar_goddard_eye_frame(void);
+u32  ar_goddard_eye_still_skips(void);
+#endif
