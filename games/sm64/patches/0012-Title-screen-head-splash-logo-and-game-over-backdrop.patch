 /**
  * Adds a display list operation that loads a translation matrix.
  */
@@ -2935,6 +2953,58 @@ void Unknown801A4B04(void) {
 }
 
 /* 2533DC -> 253728; orig name: func_801A4C0C */
+/* AR seams (ar_goddard.h): always the Mario scene view and its camera, never the last-updated view (the hand's). */
+static struct ObjCamera *ar_mscene_cam(void) { return sMSceneView != NULL ? sMSceneView->activeCam : NULL; }
+static f32 ar_view_half(int axis) {   /* the scene view's half size, as world_pos_to_screen_coords adds it */
+    return axis ? sMSceneView->lowerRight.y / 2.0f : sMSceneView->lowerRight.x / 2.0f;
+}
+s32 ar_goddard_world_to_cursor(const f32 p[3], f32 out[2]) {
+    struct ObjCamera *cam = ar_mscene_cam();
+    struct GdVec3f v;
+    if (cam == NULL) { return 0; }
+    v.x = p[0]; v.y = p[1]; v.z = p[2];
+    gd_rotate_and_translate_vec3f(&v, &cam->unkE8);                /* world_pos_to_screen_coords, step by step */
+    if (v.z > -256.0f) { return 0; }
