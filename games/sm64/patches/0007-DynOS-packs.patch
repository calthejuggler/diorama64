+/* AR: pack files are untrusted on the device; a bin larger than this, or one declaring a larger decompressed
+   length, is refused (the largest prepared actor bin is ~2 MB). */
+#define AR_DYNOS_BIN_MAX ((u64) 64 * 1024 * 1024)
