+/* AR: the floor tilt a 3D pack model of a BILLBOARD() object would get (known limit 3). obj_orient_graph returns
+ * early for a billboard object whose vanilla graph is not FORCE_3D (in AR the vanilla graph stays sharedChild), so
+ * it notes the floor normal here: render-only, indexed by pool slot, stamped with this frame (never an Object field: AR_DEEP
+ * hashes object data). The pack draw uses a note of this frame only (a coin that left the floor, or a reused slot, is
+ * never tilted by an old note), builds the matrix vanilla's obj_orient_graph would have built, and S1 puts throwMatrix back. */
+bool gArPackFloorTilt = false;
+static struct { u32 stamp; f32 n[3]; } sArOrient[OBJECT_POOL_CAPACITY];
+static u32 sArPackTilts = 0;
+void ar_note_floor_orient(struct Object *o, f32 nx, f32 ny, f32 nz) {
+    if (!ar_in_object_pool(o)) { return; }
+    const s32 i = (s32) (o - gObjectPool);
+    sArOrient[i].stamp = gGlobalTimer + 1;
+    sArOrient[i].n[0] = nx; sArOrient[i].n[1] = ny; sArOrient[i].n[2] = nz;
+}
+u32 ar_pack_tilts(void) { return sArPackTilts; }
+static struct { u32 stamp; struct Object *o; Mat4 m; } sArLastTilt;
+u32 ar_pack_tilt_last(struct Object **o, Mat4 m) {
+    *o = sArLastTilt.o;
+    mtxf_copy(m, sArLastTilt.m);
+    return sArLastTilt.stamp;
+}
+static void ar_pack_floor_tilt(struct Object *node, struct GraphNode *pack) {
+    if (!gArPackFloorTilt || node->header.gfx.throwMatrix != NULL) { return; }
+    if (!(pack->extraFlags & GRAPH_EXTRA_FORCE_3D) || !(node->header.gfx.node.flags & GRAPH_RENDER_BILLBOARD)) { return; }
+    if (!ar_in_object_pool(node)) { return; }
+    const s32 i = (s32) (node - gObjectPool);
+    if (sArOrient[i].stamp != gGlobalTimer + 1) { return; }
+    const f32 *nn = sArOrient[i].n;   /* a floor normal has ny > 0; anything else (NaN, inf, a wall) draws upright */
+    if (!isfinite(nn[0]) || !isfinite(nn[1]) || !isfinite(nn[2]) || !(nn[1] > 0.f)) { return; }
+    Mat4 *m = alloc_display_list(sizeof(*m));   /* the render pool, as vanilla's obj_orient_graph */
+    if (m == NULL) { return; }
+    Vec3f n = { nn[0], nn[1], nn[2] };
+    Vec3f pos = { node->oPosX, node->oPosY + node->oGraphYOffset, node->oPosZ };
+    mtxf_align_terrain_normal(*m, n, pos, node->oFaceAngleYaw);
+    node->header.gfx.throwMatrix = m;
+    sArPackTilts++;
+    sArLastTilt.stamp = gGlobalTimer + 1;
+    sArLastTilt.o = node;
+    mtxf_copy(sArLastTilt.m, *m);
+}
