+
+/* Vanilla graph node copies: [struct GraphNode *][size_t size][bytes], 8-byte aligned, used as a stack. */
+static u8 *sArNodeSave = NULL;
+static size_t sArNodeSaveLen = 0, sArNodeSaveCap = 0;
+
+static size_t ar_graph_node_size(s16 type) {
+    switch (type) {
+        case GRAPH_NODE_TYPE_ROOT:                 return sizeof(struct GraphNodeRoot);
+        case GRAPH_NODE_TYPE_ORTHO_PROJECTION:     return sizeof(struct GraphNodeOrthoProjection);
+        case GRAPH_NODE_TYPE_PERSPECTIVE:          return sizeof(struct GraphNodePerspective);
+        case GRAPH_NODE_TYPE_MASTER_LIST:          return sizeof(struct GraphNodeMasterList);
+        case GRAPH_NODE_TYPE_START:                return sizeof(struct GraphNodeStart);
+        case GRAPH_NODE_TYPE_LEVEL_OF_DETAIL:      return sizeof(struct GraphNodeLevelOfDetail);
+        case GRAPH_NODE_TYPE_SWITCH_CASE:          return sizeof(struct GraphNodeSwitchCase);
+        case GRAPH_NODE_TYPE_CAMERA:               return sizeof(struct GraphNodeCamera);
+        case GRAPH_NODE_TYPE_TRANSLATION_ROTATION: return sizeof(struct GraphNodeTranslationRotation);
+        case GRAPH_NODE_TYPE_TRANSLATION:          return sizeof(struct GraphNodeTranslation);
+        case GRAPH_NODE_TYPE_ROTATION:             return sizeof(struct GraphNodeRotation);
+        case GRAPH_NODE_TYPE_OBJECT:               return sizeof(struct GraphNodeObject);
+        case GRAPH_NODE_TYPE_ANIMATED_PART:        return sizeof(struct GraphNodeAnimatedPart);
+        case GRAPH_NODE_TYPE_BILLBOARD:            return sizeof(struct GraphNodeBillboard);
+        case GRAPH_NODE_TYPE_DISPLAY_LIST:         return sizeof(struct GraphNodeDisplayList);
+        case GRAPH_NODE_TYPE_SCALE:                return sizeof(struct GraphNodeScale);
+        case GRAPH_NODE_TYPE_SCALE_XYZ:            return sizeof(struct GraphNodeScaleXYZ);
+        case GRAPH_NODE_TYPE_SHADOW:               return sizeof(struct GraphNodeShadow);
+        case GRAPH_NODE_TYPE_OBJECT_PARENT:        return sizeof(struct GraphNodeObjectParent);
+        case GRAPH_NODE_TYPE_GENERATED_LIST:       return sizeof(struct GraphNodeGenerated);
+        case GRAPH_NODE_TYPE_BACKGROUND:           return sizeof(struct GraphNodeBackground);
+        case GRAPH_NODE_TYPE_HELD_OBJ:             return sizeof(struct GraphNodeHeldObject);
+        case GRAPH_NODE_TYPE_CULLING_RADIUS:       return sizeof(struct GraphNodeCullingRadius);
+        case GRAPH_NODE_TYPE_BONE:                 return sizeof(struct GraphNodeBone);
+        default:                                   return 0;
+    }
+}
+
+static bool ar_nodes_save(struct GraphNode *first, s32 depth) {
+    struct GraphNode *n = first;
+    if (n == NULL) { return true; }
+    if (depth > 64) { return false; }
+    do {
+        const size_t size = ar_graph_node_size(n->type);
+        if (size == 0) { return false; }
+        const size_t need = sizeof(struct GraphNode *) + sizeof(size_t) + ((size + 7) & ~(size_t) 7);
+        if (sArNodeSaveLen + need > sArNodeSaveCap) {
+            size_t cap = sArNodeSaveCap ? sArNodeSaveCap * 2 : 16384;
+            while (cap < sArNodeSaveLen + need) { cap *= 2; }
+            u8 *p = realloc(sArNodeSave, cap);
+            if (p == NULL) { return false; }
+            sArNodeSave = p;
+            sArNodeSaveCap = cap;
+        }
+        u8 *at = sArNodeSave + sArNodeSaveLen;
+        memcpy(at, &n, sizeof n);
+        memcpy(at + sizeof n, &size, sizeof size);
+        memcpy(at + sizeof n + sizeof size, n, size);
+        sArNodeSaveLen += need;
+        if (n->children != NULL && !ar_nodes_save(n->children, depth + 1)) { return false; }
+        n = n->next;
+    } while (n != NULL && n != first);
+    return true;
+}
+
+static void ar_nodes_restore(size_t from, size_t to) {
+    for (size_t at = from; at < to;) {
+        struct GraphNode *n;
+        size_t size;
+        memcpy(&n, sArNodeSave + at, sizeof n);
+        memcpy(&size, sArNodeSave + at + sizeof n, sizeof size);
+        memcpy(n, sArNodeSave + at + sizeof n + sizeof size, size);
+        at += sizeof n + sizeof size + ((size + 7) & ~(size_t) 7);
+    }
+}
+
+static bool ar_in_object_pool(const struct Object *o) {
