+/* ---- AR: a model-pack graph is render-only ------------------------------------------------------------
+ * Geo functions run while the graph is processed write game state (oAnimState wraps, coin angles, the held object's
+ * position, positions taken from the model's pose, Mario's punch timer, the room, ...), so a DynOS model pack, which
+ * replaces an actor's graph, would change the game. In AR an object keeps its vanilla graph (dynos_actor_override does
+ * not substitute, data/dynos_mgr_actor.cpp) and, when a pack replaces that graph, each frame:
+ *  1. state pass: the object is processed with its vanilla graph exactly where and as vanilla processes it (same
+ *     matrices, animation, switch, culling and held-object decisions, same call order), appending nothing (sArStatePass);
+ *  2. pack draw, in a sandbox: the state the state pass left (S1) is saved, the state before it (S0) is put back so the
+ *     pack graph sees what the vanilla graph saw, the pack graph draws, and S1 is restored.
+ * The sandbox holds everything the graph processors and the geo functions a pack bin may call (scripts/packs.py
+ * GEO_FUNCS, each paired with its node type) can write: the object and its prevObj, a held object and the holder's held
+ * node, the players they index (MarioState, MarioBodyState, mario_misc.c's attack counter and colours), the room globals
+ * and find_floor's flag and counters (geo_switch_area, shadows), the shadow globals and the animation globals. A held
+ * object drawn inside a pack draw with its vanilla graph also gets that graph's nodes back (their switch state is game
+ * state, e.g. Bowser's eyes). Interpolation data, the display-list pool and the shadow interpolation list are render
+ * state and are not restored. Without packs (or outside AR) nothing here runs. */
+#define AR_SB_OBJECTS 2
+#define AR_SB_PLAYERS 3
+struct ArSandbox {
+    s32 nObj;
+    struct Object *obj[AR_SB_OBJECTS];
+    struct Object objSave[AR_SB_OBJECTS];
+    struct GraphNodeHeldObject *held;
+    struct GraphNodeHeldObject heldSave;
+    s32 nPlayer;
+    u8 player[AR_SB_PLAYERS];
+    struct MarioState mario[AR_SB_PLAYERS];
+    struct MarioBodyState body[AR_SB_PLAYERS];
+    u8 misc[AR_SB_PLAYERS][AR_MARIO_MISC_STATE_BYTES];
+    s16 marioRoom, doorRoom, floorIntangible;
+    s32 floorMisses;
+    struct NumTimesCalled numCalls;
+    s8 shadowWater, shadowIce, shadowCarpet;
+    s16 shadowSurface;
+    u8 animType, animEnabled;
+    s16 animFrame, prevAnimFrame;
+    f32 animMultiplier;
+    u16 *animAttribute;
+    struct Animation *anim;
+    struct GeoAnimState geoTemp;
+    size_t nodesAt, nodesEnd;
