@@ -98,6 +103,13 @@ public:
     inline s32 Offset() const { return mOffset; }
     inline bool EoF() const { return mOffset >= mSize; }
     inline void SetOffset(s32 aOffset) const { mOffset = aOffset; }
+    /* AR: with gArDynosPacksOnly, false when aCount elements of at least aMinBytes each cannot fit in the bytes
+       left: the caller refuses the node instead of allocating what the file asks for. */
+    inline bool ArCountFits(u64 aCount, u64 aMinBytes) const {
+        if (!gArDynosPacksOnly || aCount * aMinBytes <= (u64) (mSize > mOffset ? mSize - mOffset : 0)) { return true; }
+        gArDynosBinRefused++;
+        return false;
+    }
     inline const char *GetFilename() const { return mFilename; }
 
