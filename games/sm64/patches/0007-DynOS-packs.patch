+}
+
+static struct GraphNode *ar_pack_graph(struct Object *o) {
+    if (!gArMode || !gArDynosPacksOnly || !ar_in_object_pool(o)) { return NULL; }
+    return dynos_ar_pack_graph(o->header.gfx.sharedChild);
+}
+
+static u8 ar_player_index(struct Object *o) {
+    if (o == NULL) { return 0; }
+    struct NetworkPlayer *np = network_player_from_global_index(o->globalPlayerIndex);
+    s32 index = (np == NULL) ? 0 : np->localIndex;
+    return (index < 0 || index >= MAX_PLAYERS) ? 0 : (u8) index;
+}
+
+static void ar_sb_object(struct ArSandbox *sb, struct Object *o) {
+    if (!ar_in_object_pool(o) || sb->nObj >= AR_SB_OBJECTS) { return; }
+    for (s32 i = 0; i < sb->nObj; i++) { if (sb->obj[i] == o) { return; } }
+    sb->obj[sb->nObj++] = o;
+}
+
+static void ar_sb_player(struct ArSandbox *sb, s32 index) {
+    if (index < 0 || index >= MAX_PLAYERS || sb->nPlayer >= AR_SB_PLAYERS) { return; }
+    for (s32 i = 0; i < sb->nPlayer; i++) { if (sb->player[i] == index) { return; } }
+    sb->player[sb->nPlayer++] = (u8) index;
+}
+
+static void ar_sb_init(struct ArSandbox *sb, struct Object *obj, struct GraphNodeHeldObject *heldNode,
+                       struct Object *processing, struct MarioState *marioState) {
+    sb->nObj = 0;
+    sb->nPlayer = 0;
+    sb->held = heldNode;
+    sb->nodesAt = sb->nodesEnd = sArNodeSaveLen;
+    ar_sb_object(sb, obj);
+    if (obj != NULL) { ar_sb_object(sb, obj->prevObj); }   /* geo_update_*_from_parent, geo_move_mario_part_from_parent */
+    ar_sb_player(sb, 0);
+    ar_sb_player(sb, ar_player_index(processing));
+    if (marioState != NULL) { ar_sb_player(sb, (s32) (marioState - gMarioStates)); }
+}
+
+/* Sandboxes are about 8 KB each (two per object draw, nested up to 1 object + 4 held draws): a static pool indexed by the
+ * nesting depth keeps them off the game thread's stack (5 draws deep would be about 80 KB there). */
+#define AR_SB_POOL 12
+_Static_assert(sizeof(struct ArSandbox) <= 8192, "struct ArSandbox: 2 sandboxes per draw, AR_SB_POOL of them");
+static struct ArSandbox sArSbPool[AR_SB_POOL];
+static s32 sArSbUsed = 0;
+static struct ArSandbox *ar_sb_acquire_pair(void) {
+    if (sArSbUsed + 2 > AR_SB_POOL) { return NULL; }
+    struct ArSandbox *pair = &sArSbPool[sArSbUsed];
+    sArSbUsed += 2;
+    return pair;
+}
+static void ar_sb_release_pair(void) { sArSbUsed -= 2; }
+
+static void ar_sb_save(struct ArSandbox *sb) {
+    for (s32 i = 0; i < sb->nObj; i++) { sb->objSave[i] = *sb->obj[i]; }
+    if (sb->held != NULL) { sb->heldSave = *sb->held; }
+    for (s32 i = 0; i < sb->nPlayer; i++) {
+        sb->mario[i] = gMarioStates[sb->player[i]];
+        sb->body[i] = gBodyStates[sb->player[i]];
+        ar_mario_misc_state_save(sb->player[i], sb->misc[i]);
+    }
+    sb->marioRoom = gMarioCurrentRoom;
+    sb->doorRoom = gDoorCurrentRoom;
+    sb->floorIntangible = gFindFloorIncludeSurfaceIntangible;
+    sb->floorMisses = gNumFindFloorMisses;
+    sb->numCalls = gNumCalls;
+    sb->shadowWater = gShadowAboveWaterOrLava;
+    sb->shadowIce = gMarioOnIceOrCarpet;
+    sb->shadowCarpet = sMarioOnFlyingCarpet;
+    sb->shadowSurface = sSurfaceTypeBelowShadow;
+    sb->animType = gCurAnimType;
+    sb->animEnabled = gCurAnimEnabled;
+    sb->animFrame = gCurrAnimFrame;
+    sb->prevAnimFrame = gPrevAnimFrame;
+    sb->animMultiplier = gCurAnimTranslationMultiplier;
+    sb->animAttribute = gCurrAnimAttribute;
+    sb->anim = gCurAnim;
+    sb->geoTemp = gGeoTempState;
+}
+
+static void ar_sb_restore(const struct ArSandbox *sb) {
+    for (s32 i = 0; i < sb->nObj; i++) { *sb->obj[i] = sb->objSave[i]; }
+    if (sb->held != NULL) { *sb->held = sb->heldSave; }
+    for (s32 i = 0; i < sb->nPlayer; i++) {
+        gMarioStates[sb->player[i]] = sb->mario[i];
+        gBodyStates[sb->player[i]] = sb->body[i];
+        ar_mario_misc_state_restore(sb->player[i], sb->misc[i]);
+    }
+    gMarioCurrentRoom = sb->marioRoom;
+    gDoorCurrentRoom = sb->doorRoom;
+    gFindFloorIncludeSurfaceIntangible = sb->floorIntangible;
+    gNumFindFloorMisses = sb->floorMisses;
+    gNumCalls = sb->numCalls;
+    gShadowAboveWaterOrLava = sb->shadowWater;
