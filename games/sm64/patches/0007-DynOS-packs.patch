+static void geo_process_object(struct Object *node) {
+    struct GraphNode *pack = sArStatePass ? NULL : ar_pack_graph(node);
+    if (pack == NULL) {   /* no pack (or this is a state pass: vanilla all the way down) */
+        geo_process_object_body(node);
+        return;
+    }
+    struct ArSandbox *pair = ar_sb_acquire_pair();
+    if (pair == NULL) { geo_process_object_body(node); return; }
+    struct GraphNode *vanilla = node->header.gfx.sharedChild;
+    struct ArSandbox *s0 = &pair[0], *s1 = &pair[1];
+    ar_sb_init(s0, node, NULL, node, get_mario_state_from_object(node));
+    *s1 = *s0;
+    if (sArPackDraw == 0) {   /* inside a pack draw the outer sandbox discards everything: no state pass needed */
+        ar_sb_save(s0);
+        sArStatePass++;
+        geo_process_object_body(node);
+        sArStatePass--;
+    }
+    ar_sb_save(s1);
+    if (sArPackDraw == 0) { ar_sb_restore(s0); }
+    ar_pack_floor_tilt(node, pack);   /* AR: S1 (below) restores throwMatrix after the pack draw */
+    node->header.gfx.sharedChild = pack;
+    sArPackDraw++;
+    geo_process_object_body(node);
+    sArPackDraw--;
+    node->header.gfx.sharedChild = vanilla;
+    ar_sb_restore(s1);
+    ar_sb_release_pair();
+    sArPackDrawn++;
+}
+
+static s32 ar_held_object(struct GraphNodeHeldObject *node) {
+    static s32 sDepth = 0;   /* held draws nested inside a pack draw: a pack actor may hold Mario's held object, itself */
+    struct Object *obj = node->objNode;
+    struct GraphNode *pack = sArStatePass ? NULL : ar_pack_graph(obj);
+    if (pack == NULL && sArPackDraw == 0) { return geo_process_held_object_body(node); }
+    if (sArPackDraw > 0 && sDepth >= 4) { return TRUE; }
+    struct GraphNode *vanilla = obj->header.gfx.sharedChild;
+    struct ArSandbox *pair = ar_sb_acquire_pair();
+    if (pair == NULL) { return geo_process_held_object_body(node); }
+    struct ArSandbox *s0 = &pair[0], *s1 = &pair[1];
+    ar_sb_init(s0, obj, node, gCurGraphNodeProcessingObject, gCurGraphNodeMarioState);
+    *s1 = *s0;
+    s32 ok = TRUE;
+    if (sArPackDraw == 0) {   /* the holder draws as vanilla: run the held object's vanilla part for the state first */
+        ar_sb_save(s0);
+        sArStatePass++;
+        ok = geo_process_held_object_body(node);
+        sArStatePass--;
+    }
+    ar_sb_save(s1);
+    if (pack == NULL) {   /* inside a pack draw, an object without a pack draws its vanilla graph: keep its nodes */
+        if (!ar_nodes_save(vanilla, 0)) { sArNodeSaveLen = s1->nodesAt; ar_sb_release_pair(); return ok; }
+        s1->nodesEnd = sArNodeSaveLen;
+    }
+    if (sArPackDraw == 0) { ar_sb_restore(s0); }
+    if (pack != NULL) { obj->header.gfx.sharedChild = pack; }
+    sArPackDraw++;
+    sDepth++;
+    s32 drawn = geo_process_held_object_body(node);
+    sDepth--;
+    sArPackDraw--;
+    obj->header.gfx.sharedChild = vanilla;
+    ar_sb_restore(s1);
+    sArNodeSaveLen = s1->nodesAt;
+    ar_sb_release_pair();
+    if (pack != NULL) { sArPackDrawn++; }
+    return sArPackDraw == 0 ? ok : drawn;
+}
+/* AR: test hook. Appends to a throwaway master list with layers a hostile pack could produce; returns how
+ * many the bounds refused (all of them, in AR with packs only) and leaves the real state alone. */
+s32 ar_layer_clamp_probe(void) {
+    static const s16 layers[] = { 8, 9, 0x7F, -1, -4, 0x7FFF, -0x8000 };
+    struct GraphNodeMasterList list;
+    struct GraphNodeMasterList *saved = gCurGraphNodeMasterList;
+    const u32 before = gArGfxClamped;
+    memset(&list, 0, sizeof(list));
+    gCurGraphNodeMasterList = &list;
+    for (u32 i = 0; i < sizeof(layers) / sizeof(layers[0]); i++) { geo_append_display_list(NULL, layers[i]); }
+    gCurGraphNodeMasterList = saved;
+    for (s32 i = 0; i < GFX_NUM_MASTER_LISTS; i++) {
+        if (list.listHeads[i] != NULL || list.listTails[i] != NULL) { return -1; }
+    }
+    return (s32) (gArGfxClamped - before);
+}
