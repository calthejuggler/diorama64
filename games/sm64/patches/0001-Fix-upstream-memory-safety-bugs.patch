         Gfx *pos = interp->pos;
         Mtx *srcMtx = interp->mtx;
         Mtx *srcMtxPrev = interp->mtxPrev;
+        Mtx bufMtx, bufMtxPrev;   // outlive the if: srcMtx/srcMtxPrev point at them below
 
