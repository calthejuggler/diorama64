 }
 
 u8* rom_assets_decompress(u32* data, u32* decompressedSize) {
+    if (*decompressedSize < 16) {   // shorter than an MIO0 header: never compressed (and data[0] would read past the end)
+        return NULL;
+    }
     if (BSWAP32(data[0]) != 0x4d494f30) {
         return NULL;
     }
