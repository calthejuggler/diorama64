diff --git a/src/pc/gfx/gfx_ar_hooks.h b/src/pc/gfx/gfx_ar_hooks.h
index e69de29..6a18656 100644
--- a/src/pc/gfx/gfx_ar_hooks.h
+++ b/src/pc/gfx/gfx_ar_hooks.h
@@ -0,0 +1,30 @@
+#ifndef GFX_AR_HOOKS_H
+#define GFX_AR_HOOKS_H
+/* AR seams. With gGfxArHooks == NULL and gArMode == false, gfx_pc and the game behave exactly like upstream. */
+#include <stdbool.h>
+#include <stdint.h>
+
+/* G_NOOP tag word: "AR" in the high 16 bits, kind in bits 8..15, argument in bits 0..7. */
+#define GFX_AR_TAG_MAGIC 0x41520000u
+#define GFX_AR_TAG(kind, arg) (GFX_AR_TAG_MAGIC | (((uint32_t)(kind) & 0xFFu) << 8) | ((uint32_t)(arg) & 0xFFu))
+enum { GFX_AR_TAG_SPACE = 1, GFX_AR_TAG_GROUP_BEGIN = 2, GFX_AR_TAG_GROUP_END = 3, GFX_AR_TAG_FOCUS = 4 };
+enum { GFX_AR_SPACE_SCREEN = 0, GFX_AR_SPACE_WORLD = 1, GFX_AR_SPACE_DISCARD = 2 };
+enum { GFX_AR_CULL_NONE = 0, GFX_AR_CULL_BACK = 1, GFX_AR_CULL_FRONT = 2 };
+enum { GFX_AR_GROUP_MISC = 1, GFX_AR_GROUP_COUNTERS = 2, GFX_AR_GROUP_POWER_METER = 3,
+       GFX_AR_GROUP_DIALOG = 4, GFX_AR_GROUP_PAUSE = 5 };
+
+struct GfxArHooks {
+    void (*set_space)(int space);      /* GFX_AR_SPACE_*, after the pending batch was flushed */
+    void (*set_cull)(int cull);         /* GFX_AR_CULL_*, WORLD only, after a flush */
+    void (*group)(int begin, int id);   /* overlay group BEGIN (1) / END (0), after a flush */
+    void (*focus)(int owner);           /* FOCUS tag: 0, or player index + 1 (x-ray silhouette owner), after a flush */
+};
+extern struct GfxArHooks *gGfxArHooks;   /* NULL = upstream behaviour */
+extern bool gArMode;
+
+/* Game code: emit a tag into the display list being built. No-op unless gArMode. */
+#define GFX_AR_EMIT_TAG(kind, arg) do { if (gArMode) { gDPNoOpTag(gDisplayListHead++, GFX_AR_TAG(kind, arg)); } } while (0)
+/* Lighting camera: rotation used for lights and texgen of WORLD draws. */
+void gfx_ar_set_shading_view(const float m[4][4]);
+void gfx_ar_clear_shading_view(void);
+#endif
