+static void gfx_ar_report_cull(void) {
+    int cull = GFX_AR_CULL_NONE;
+    uint32_t mode = rsp.geometry_mode & G_CULL_BOTH;
+    if (mode == G_CULL_BACK) { cull = GFX_AR_CULL_BACK; }
+    else if (mode == G_CULL_FRONT) { cull = GFX_AR_CULL_FRONT; }   /* G_CULL_BOTH stays NONE (upstream hack) */
+    if (cull != GFX_AR_CULL_NONE && (rsp.geometry_mode & G_CULL_INVERT_EXT)) {
+        cull = (cull == GFX_AR_CULL_BACK) ? GFX_AR_CULL_FRONT : GFX_AR_CULL_BACK;
+    }
+    if (cull != sArCull) {
+        gfx_flush();
+        sArCull = cull;
+        if (gGfxArHooks->set_cull) { gGfxArHooks->set_cull(cull); }
+    }
+}
