 struct SynthesisReverb gSynthesisReverbs[4];
 u8 sAudioSynthesisPad[0x10];
@@ -408,7 +496,9 @@ u64 *synthesis_execute(u64 *cmdBuf, s32 *writtenCmds, s16 *aiBuf, s32 bufLen) {
         if (gSynthesisReverb.useReverb != 0) {
             prepare_reverb_ring_buffer(chunkLen, gAudioUpdatesPerFrame - i);
         }
+        if (gArMode && gArSpatialSfx) { sArChunkStart = gArSfxFrames; }   /* where this chunk lands in the tick */
         cmd = synthesis_do_one_audio_update((s16 *) aiBufPtr, chunkLen, cmd, gAudioUpdatesPerFrame - i);
+        if (gArMode && gArSpatialSfx) { gArSfxFrames += chunkLen; }
         bufLen -= chunkLen;
         aiBufPtr += chunkLen;
     }
@@ -1742,6 +1832,18 @@ u64 *process_envelope(u64 *cmd, struct NoteSubEu *note, struct NoteSynthesisStat
     // in, dry left, count without A_AUX flag.
     // dry right, wet left, wet right with A_AUX flag.
 
+#if defined(VERSION_JP) || defined(VERSION_US)
+    /* arCh: the note's SFX or music target. A note still carrying stereo-strong or headset flags (its
+     * pan pass saw another classification; the threading rule in ar_audio_hooks.h forbids that) stays in the bed: those
+     * paths reuse the scratch pair below. */
+    const s32 arCh = (note->stereoStrongLeft || note->stereoStrongRight || note->usesHeadsetPanEffects)
+                         ? -1 : ar_note_target(note);
+    if (arCh >= 0) {   /* dry into the cleared scratch pair (free here: stereo-strong is off for this note); wet into the reverb */
+        aClearBuffer(cmd++, DMEM_ADDR_STEREO_STRONG_TEMP_DRY, DEFAULT_LEN_2CH);
+        aSetBuffer(cmd++, 0, inBuf, DMEM_ADDR_STEREO_STRONG_TEMP_DRY, nSamples * 2);
+        aSetBuffer(cmd++, A_AUX, DMEM_ADDR_STEREO_STRONG_TEMP_WET, DMEM_ADDR_WET_LEFT_CH, DMEM_ADDR_WET_RIGHT_CH);
+    } else
+#endif
     if (note->usesHeadsetPanEffects) {
         aClearBuffer(cmd++, DMEM_ADDR_NOTE_PAN_TEMP, DEFAULT_LEN_1CH);
 
@@ -1855,6 +1957,9 @@ u64 *process_envelope(u64 *cmd, struct NoteSubEu *note, struct NoteSynthesisStat
                  /*out*/ DMEM_ADDR_RIGHT_CH);
         }
     }
+#if defined(VERSION_JP) || defined(VERSION_US)
+    if (arCh >= 0) { cmd = ar_sfx_save(cmd, arCh, nSamples); }
+#endif
     return cmd;
 }
 
@@ -2121,7 +2226,15 @@ void note_set_vel_pan_reverb(struct Note *note, f32 velocity, f32 pan, u8 reverb
 #else
