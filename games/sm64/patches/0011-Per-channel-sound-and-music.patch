+     * before it moves on; this relies on the single game thread (get_sound_pan is also Lua-exported, smlua_audio_utils.c). */
+    if (sArSpatialNow) { return US_FLOAT(0.5); }
     f32 absX;
     f32 absZ;
     f32 pan;
@@ -1280,17 +1333,18 @@ static f32 get_sound_volume(u8 bank, u8 soundIndex, f32 volumeRange) {
 #else
         // Intensity linearly lowers from 1 at the camera to 1 - volumeRange at maxSoundDistance,
         // then it goes from 1 - volumeRange at maxSoundDistance to 0 at AUDIO_MAX_DISTANCE
-        if (sSoundBanks[bank][soundIndex].distance > AUDIO_MAX_DISTANCE) {
+        const f32 distance = sArSpatialNow ? 0.0f : sSoundBanks[bank][soundIndex].distance;
+        if (distance > AUDIO_MAX_DISTANCE) {
             intensity = 0.0f;
         } else {
             maxSoundDistance = get_level_acoustic_reaches(gCurrLevelNum) / div;
-            if (maxSoundDistance < sSoundBanks[bank][soundIndex].distance) {
-                intensity = ((AUDIO_MAX_DISTANCE - sSoundBanks[bank][soundIndex].distance)
+            if (maxSoundDistance < distance) {
+                intensity = ((AUDIO_MAX_DISTANCE - distance)
                              / (AUDIO_MAX_DISTANCE - maxSoundDistance))
                             * (1.0f - volumeRange);
             } else {
                 intensity =
-                    1.0f - sSoundBanks[bank][soundIndex].distance / maxSoundDistance * volumeRange;
+                    1.0f - distance / maxSoundDistance * volumeRange;
             }
         }
 #endif
@@ -1321,7 +1375,7 @@ static f32 get_sound_freq_scale(u8 bank, u8 item) {
     f32 amount;
 
     if (!(sSoundBanks[bank][item].soundBits & SOUND_CONSTANT_FREQUENCY)) {
-        amount = sSoundBanks[bank][item].distance / AUDIO_MAX_DISTANCE;
+        amount = (sArSpatialNow ? 0.0f : sSoundBanks[bank][item].distance) / AUDIO_MAX_DISTANCE;
         if (sSoundBanks[bank][item].soundBits & SOUND_VIBRATO) {
             amount += (f32)(gAudioRandom & 0xff) / US_FLOAT(64.0);
         }
@@ -1362,10 +1416,11 @@ static u8 get_sound_reverb(UNUSED u8 bank, UNUSED u8 soundIndex, u8 channelIndex
     // reverb = reverb adjustment + level reverb + a volume-dependent value
     // The volume-dependent value is 0 when volume is at maximum, and raises to
     // LOW_VOLUME_REVERB when the volume is 0
+    f32 arVolume = gSequencePlayers[SEQ_PLAYER_SFX].channels[channelIndex]->volume;
+    if (gArMode && gArReverbOriginal && sArSpatialNow) { arVolume = sArVolumeOriginal[channelIndex]; }
     reverb = (u8)((u8) gSequencePlayers[SEQ_PLAYER_SFX].channels[channelIndex]->soundScriptIO[5]
                   + get_level_area_reverb(level, area)
-                  + (US_FLOAT(1.0) - gSequencePlayers[SEQ_PLAYER_SFX].channels[channelIndex]->volume)
-                        * LOW_VOLUME_REVERB);
+                  + (US_FLOAT(1.0) - arVolume) * LOW_VOLUME_REVERB);
 
     if (reverb > 0x7f) {
         reverb = 0x7f;
@@ -1416,6 +1471,7 @@ static void update_game_sound(void) {
 
         for (i = 0; i < sUsedChannelsForSoundBank[bank]; i++) {
             soundIndex = sCurrentSound[bank][i];
+            sArSpatialNow = ar_sfx_update_channel(channelIndex, bank, soundIndex);
 
             if (soundIndex < SOUND_INDEX_COUNT && sSoundBanks[bank][soundIndex].soundStatus != SOUND_STATUS_STOPPED) {
                 soundStatus = sSoundBanks[bank][soundIndex].soundBits & SOUNDARGS_MASK_STATUS;
@@ -1762,7 +1818,12 @@ static void update_game_sound(void) {
 #endif
             }
 
+            if (sArSpatialNow) {   /* what vanilla would have set (read-only maths), for "Original" next tick */
+                sArSpatialNow = 0;
+                sArVolumeOriginal[channelIndex] = get_sound_volume(bank, soundIndex, ar_volume_range(bank));
+            }
             // Increment to the next channel that this bank owns
+            sArSpatialNow = 0;
             channelIndex++;
         }
 
