diff --git a/src/audio/synthesis.c b/src/audio/synthesis.c
index 862d512..9ab7f03 100644
--- a/src/audio/synthesis.c
+++ b/src/audio/synthesis.c
@@ -8,6 +8,8 @@
 #include "external.h"
 
 #include "../pc/mixer.h"
+#include "ar_audio_hooks.h"
+#include "pc/gfx/gfx_ar_hooks.h"
 
 #ifndef VERSION_SH
 #define DMEM_ADDR_TEMP 0x0
@@ -78,6 +80,92 @@ u64 *process_envelope_inner(u64 *cmd, struct Note *note, s32 nSamples, u16 inBuf
 u64 *note_apply_headset_pan_effects(u64 *cmd, struct Note *note, s32 bufLen, s32 flags, s32 leftRight);
 #endif
 
+/* spatial SFX. Inert unless gArMode && gArSpatialSfx (ar_audio_hooks.h). */
+bool gArSpatialSfx = false;
+bool gArSfxAllowSpatial = true;
+u8 gArSfxChannelSpatial[AR_SFX_CHANNELS];
+f32 gArSfxAccum[AR_SFX_CHANNELS][AR_SFX_TICK_FRAMES];
+u8 gArSfxActive[AR_SFX_CHANNELS];
+s32 gArSfxFrames;
+u32 gArSfxOverflow;
+static s32 sArChunkStart;
+_Static_assert(AR_SFX_CHANNELS == CHANNELS_MAX, "one accumulator per SFX sequence channel");
+u8 ar_sfx_channel_tag(struct SequenceChannel *ch) {
+    if (!gArMode || ch == NULL || ch->seqPlayer != &gSequencePlayers[SEQ_PLAYER_SFX]) { return 0; }   /* whatever the flags */
+    for (s32 i = 0; i < AR_SFX_CHANNELS; i++) {
+        if (gSequencePlayers[SEQ_PLAYER_SFX].channels[i] == ch) { return (u8) (i + 1); }
+    }
+    return 0;
+}
+/* the level music per channel. Inert unless gArMode && gArSpatialSfx && gArSpatialMusic. */
+bool gArSpatialMusic = false;
+f32 gArMusicAccum[AR_MUSIC_CHANNELS][AR_SFX_TICK_FRAMES];
+u8 gArMusicActive[AR_MUSIC_CHANNELS];
+#define AR_MUSIC_TARGET 128   /* ar_note_target(): 0..71 an SFX channel, AR_MUSIC_TARGET + c a music channel */
+_Static_assert(AR_MUSIC_TARGET >= AR_SFX_CHANNELS, "music targets follow the SFX channels");
+/* the environment player's event music per channel. */
+bool gArSpatialEnvMusic = false;
+f32 gArEnvAccum[AR_ENV_CHANNELS][AR_SFX_TICK_FRAMES];
+u8 gArEnvActive[AR_ENV_CHANNELS];
+#define AR_ENV_TARGET (AR_MUSIC_TARGET + AR_MUSIC_CHANNELS)
+u8 ar_music_channel_tag(struct SequenceChannel *ch) {
+    if (!gArMode || ch == NULL) { return 0; }   /* whatever the flags */
+    for (s32 p = 0; p < 2; p++) {               /* SEQ_PLAYER_LEVEL 1..16, SEQ_PLAYER_ENV 17..32 */
+        const s32 player = p == 0 ? SEQ_PLAYER_LEVEL : SEQ_PLAYER_ENV;
+        if (ch->seqPlayer != &gSequencePlayers[player]) { continue; }
+        for (s32 i = 0; i < AR_MUSIC_CHANNELS; i++) {
+            if (gSequencePlayers[player].channels[i] == ch) { return (u8) (1 + 16 * p + i); }
+        }
+    }
+    return 0;
+}
+void ar_sfx_tick_reset(void) {
+    for (s32 c = 0; c < AR_SFX_CHANNELS; c++) {
+        if (gArSfxActive[c]) { memset(gArSfxAccum[c], 0, sizeof(gArSfxAccum[c])); gArSfxActive[c] = 0; }
+    }
+    for (s32 c = 0; c < AR_MUSIC_CHANNELS; c++) {
+        if (gArMusicActive[c]) { memset(gArMusicAccum[c], 0, sizeof(gArMusicAccum[c])); gArMusicActive[c] = 0; }
+    }
+    for (s32 c = 0; c < AR_ENV_CHANNELS; c++) {
+        if (gArEnvActive[c]) { memset(gArEnvAccum[c], 0, sizeof(gArEnvAccum[c])); gArEnvActive[c] = 0; }
+    }
+    gArSfxFrames = 0;
+}
+#if defined(VERSION_JP) || defined(VERSION_US)
+static s16 sArDryL[DEFAULT_LEN_1CH / 2 + 8], sArDryR[DEFAULT_LEN_1CH / 2 + 8];   /* aSaveBuffer rounds up to 8 bytes */
+static s32 ar_sfx_note_channel(struct Note *note) {
+    if (!(gArMode && gArSpatialSfx && gArSfxAllowSpatial) || note->arSfxChannel == 0) { return -1; }
+    const s32 c = note->arSfxChannel - 1;
+    return gArSfxChannelSpatial[c] ? c : -1;
+}
+/* Where a note is mixed: an SFX channel (0..71), a music channel (AR_MUSIC_TARGET + c), or the bed (-1). */
+static s32 ar_note_target(struct Note *note) {
+    const s32 c = ar_sfx_note_channel(note);
+    if (c >= 0) { return c; }
+    const s32 t = note->arMusicChannel;
+    if (!(gArMode && gArSpatialSfx) || t == 0) { return -1; }
+    if (t <= AR_MUSIC_CHANNELS) { return gArSpatialMusic ? AR_MUSIC_TARGET + t - 1 : -1; }
+    return gArSpatialEnvMusic ? AR_ENV_TARGET + t - 1 - AR_MUSIC_CHANNELS : -1;
+}
+/* After the env mixer put the note's dry signal into the scratch pair: read it back and add (L + R) / sqrt(2), the note
+ * at unity under the centre pan law, into the target's accumulator (float: notes of one source never clip each other).
+ * ch is an ar_note_target(): an SFX channel or AR_MUSIC_TARGET + a music channel. */
+static u64 *ar_sfx_save(u64 *cmd, s32 ch, s32 n) {
+    aSetBuffer(cmd++, 0, 0, DMEM_ADDR_STEREO_STRONG_TEMP_DRY, n * 2);
+    aSaveBuffer(cmd++, sArDryL);
+    aSetBuffer(cmd++, 0, 0, DMEM_ADDR_STEREO_STRONG_TEMP_WET, n * 2);
+    aSaveBuffer(cmd++, sArDryR);
+    const s32 at = sArChunkStart;
+    if (at < 0 || at + n > AR_SFX_TICK_FRAMES) { gArSfxOverflow += (u32) n; return cmd; }
+    f32 *acc = ch >= AR_ENV_TARGET ? &gArEnvAccum[ch - AR_ENV_TARGET][at]
+             : ch >= AR_MUSIC_TARGET ? &gArMusicAccum[ch - AR_MUSIC_TARGET][at] : &gArSfxAccum[ch][at];
+    for (s32 i = 0; i < n; i++) { acc[i] += ((f32) sArDryL[i] + (f32) sArDryR[i]) * 0.70710678f; }
+    if (ch >= AR_ENV_TARGET) { gArEnvActive[ch - AR_ENV_TARGET] = 1; }
+    else if (ch >= AR_MUSIC_TARGET) { gArMusicActive[ch - AR_MUSIC_TARGET] = 1; } else { gArSfxActive[ch] = 1; }
+    return cmd;
+}
+#endif
+
