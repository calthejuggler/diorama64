 src/audio/playback.c       |   3 +
 src/audio/synthesis.c      | 115 ++++++++++++++++++++++++++++++++++++-
 src/pc/pc_main.c           |   2 +
 6 files changed, 241 insertions(+), 9 deletions(-)

diff --git a/src/audio/ar_audio_hooks.h b/src/audio/ar_audio_hooks.h
index e69de29..2ac6486 100644
--- a/src/audio/ar_audio_hooks.h
+++ b/src/audio/ar_audio_hooks.h
@@ -0,0 +1,51 @@
+#ifndef AR_AUDIO_HOOKS_H
+#define AR_AUDIO_HOOKS_H
+/* AR spatial SFX seams (0011-Per-channel-sound-and-music.patch). Inert unless gArMode && gArSpatialSfx. Then the notes of spatial
+ * SFX channels are env-mixed at centre gain into per-channel mono accumulators instead of the stereo mix, and those
+ * channels lose SM64's pan, distance volume loss and distance pitch rise: the platform spatializes them. notes
+ * of level-music channels are split the same way while gArSpatialMusic; their reverb send stays in the bed. The host
+ * reads the accumulators once per tick, after buffer_audio() played the tick, and then calls ar_sfx_tick_reset().
+ * Threading: every global below is written only on the game thread, between buffer_audio() calls (never while a buffer
+ * is synthesized), so a note's pan pass and its envelope step see the same classification. */
+#include <stdbool.h>
+#include <PR/ultratypes.h>
+struct SequenceChannel;
+#define AR_SFX_CHANNELS 72          /* CHANNELS_MAX (internal.h): the SFX sequence player's channels, one per (bank, slot) */
+#define AR_SFX_TICK_FRAMES 1088     /* 2 * SAMPLES_HIGH (pc_main.c): the most frames one buffer_audio() makes */
+extern bool gArSpatialSfx;                                     /* host, before the first tick: spatial SFX mode */
+extern bool gArSfxAllowSpatial;
+extern u8   gArSfxChannelSpatial[AR_SFX_CHANNELS];
+extern f32  gArSfxAccum[AR_SFX_CHANNELS][AR_SFX_TICK_FRAMES];  /* mono at unity (s16 scale), this tick's frames */
+extern u8   gArSfxActive[AR_SFX_CHANNELS];
+extern s32  gArSfxFrames;
+extern u32  gArSfxOverflow;
+u8   ar_sfx_channel_tag(struct SequenceChannel *ch);
+void ar_sfx_tick_reset(void);
+#define AR_MUSIC_CHANNELS 16
+extern bool gArSpatialMusic;        /* host, between ticks, game thread: split the level music per channel (spatial mode only) */
+extern f32  gArMusicAccum[AR_MUSIC_CHANNELS][AR_SFX_TICK_FRAMES];   /* mono at unity (s16 scale), this tick's frames */
+extern u8   gArMusicActive[AR_MUSIC_CHANNELS];
+u8   ar_music_channel_tag(struct SequenceChannel *ch);
+struct ArSfxChannelInfo {
+    u8 has_sound;
+    u8 spatial;
+    u8 bank;
+    u8 no_volume_loss;
+    u32 soundBits;
+    const f32 *source;    /* the emitter's position pointer: identity only (compare, never dereference) */
+    f32 vec[3];           /* the listener-space vector update_game_sound read (AR: the head listener vector) */
+};
+void ar_sfx_channel_info(s32 channel, struct ArSfxChannelInfo *out);
+/* from here on ar_sfx_channel_tag / ar_music_channel_tag tag a note whenever gArMode (the mix still checks the
+ * flags), so a note started in one sound mode is tapped after a live switch. gArReverbOriginal (host, between ticks): a
+ * spatial SFX channel's reverb send keeps vanilla's distance term ((1 - the volume vanilla would set) x LOW_VOLUME_REVERB);
+ * false (default): the send as at the listener (distance-free volume). */
+extern bool gArReverbOriginal;
+/* the environment player's channels are tagged too (arMusicChannel 17..32; 1..16 stay SEQ_PLAYER_LEVEL's) and,
+ * while gArSpatialEnvMusic (host, between ticks: an event song plays and the user wants it on the ring), split per channel
+ * into gArEnvAccum like the level music; their reverb send stays in the bed. Cleared by ar_sfx_tick_reset. */
+#define AR_ENV_CHANNELS 16
+extern bool gArSpatialEnvMusic;
+extern f32  gArEnvAccum[AR_ENV_CHANNELS][AR_SFX_TICK_FRAMES];
+extern u8   gArEnvActive[AR_ENV_CHANNELS];
+#endif
