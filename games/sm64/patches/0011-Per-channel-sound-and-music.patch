+/* sArSpatialNow is set while update_game_sound updates a spatial channel. */
+static u8 sArSpatialNow;
+static struct ArSfxChannelInfo sArChannel[AR_SFX_CHANNELS];
+/* the game-reverb seam. sArVolumeOriginal: the volume vanilla would have set on each spatial channel (its
+ * real listener distance), refreshed every tick; get_sound_reverb reads it with gArReverbOriginal. Two approximations,
+ * audible only with Original: the MOVING bank's volume leaves out vanilla's (speed + 8) / 16 factor below speed 8 (so
+ * the send is a little higher than vanilla's there), and a channel's first tick with a new sound reads the value its
+ * previous sound left (0 before any: +LOW_VOLUME_REVERB for that tick), as vanilla's own send lags one tick. */
+bool gArReverbOriginal = false;
+static f32 sArVolumeOriginal[AR_SFX_CHANNELS];
+static f32 ar_volume_range(u8 bank) {
+    switch (bank) {
+        case SOUND_BANK_GENERAL: case SOUND_BANK_ENV: case SOUND_BANK_OBJ: case SOUND_BANK_AIR: case SOUND_BANK_GENERAL2:
+        case SOUND_BANK_OBJ2: return VOLUME_RANGE_UNK2;
+        default: return VOLUME_RANGE_UNK1;
+    }
+}
+static u8 ar_sfx_classify(u8 bank, u8 soundIndex) {
+    if (!(gArMode && gArSpatialSfx && gArSfxAllowSpatial)) { return 0; }
+    if (bank == SOUND_BANK_MENU) { return 0; }                                      /* menu and UI: the bed */
+    const struct SoundCharacteristics *s = &sSoundBanks[bank][soundIndex];
+    if (s->x == &gGlobalSoundSource[0]) { return 0; }                               /* "at the listener": the bed */
+    if (bank == SOUND_BANK_MOVING && (s->soundBits & SOUND_CONSTANT_FREQUENCY)) { return 0; }   /* vanilla: non-positional */
+    return 1;
+}
+static u8 ar_sfx_update_channel(u8 channel, u8 bank, u8 soundIndex) {
+    if (!gArMode || channel >= AR_SFX_CHANNELS) { return 0; }
+    struct ArSfxChannelInfo *c = &sArChannel[channel];
+    c->bank = bank;
+    if (soundIndex >= SOUND_INDEX_COUNT || sSoundBanks[bank][soundIndex].soundStatus == SOUND_STATUS_STOPPED) {
+        c->has_sound = 0;          /* no current sound: classification and position hold (release tails) */
+        return 0;
+    }
+    const struct SoundCharacteristics *s = &sSoundBanks[bank][soundIndex];
+    c->has_sound = 1;
+    c->soundBits = s->soundBits;
+    c->source = s->x;
+    c->no_volume_loss = (s->soundBits & SOUND_NO_VOLUME_LOSS) != 0;
+    c->vec[0] = *s->x; c->vec[1] = *s->y; c->vec[2] = *s->z;   /* the same read get_sound_pan makes below */
+    c->spatial = ar_sfx_classify(bank, soundIndex);
+    gArSfxChannelSpatial[channel] = c->spatial;
+    return c->spatial;
+}
+void ar_sfx_channel_info(s32 channel, struct ArSfxChannelInfo *out) {
+    if (channel < 0 || channel >= AR_SFX_CHANNELS) { memset(out, 0, sizeof(*out)); return; }
+    *out = sArChannel[channel];
+}
+
