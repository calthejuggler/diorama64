+static void gfx_ar_report_material(void) {
+    int mat = ((rsp.geometry_mode & G_LIGHTING) ? GFX_AR_MAT_LIT : 0) | ((rsp.geometry_mode & G_TEXTURE_GEN) ? GFX_AR_MAT_TEXGEN : 0);
+    if (mat != sArMat) {
+        gfx_flush();
+        sArMat = mat;
+        if (gGfxArHooks->material) { gGfxArHooks->material(mat); }
+    }
+}
