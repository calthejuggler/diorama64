 src/game/rendering_graph_node.c | 44 ++++++++++++++++++++++++++++++
 src/pc/gfx/gfx_ar_hooks.h       | 17 +++++++++++-
 src/pc/gfx/gfx_pc.c             | 48 +++++++++++++++++++++++++++------
 4 files changed, 101 insertions(+), 9 deletions(-)

