 struct MarioState* gCurGraphNodeMarioState = NULL;
 static s32 sArNoFocus = FALSE;   /* AR: set while a player's blob shadow is appended (not part of the silhouette) */
+static s32 sArEffect = FALSE;   /* AR: set while an environment effect list (geo_envfx_main) is appended */
+/* AR: Bowser in the Fire Sea's arena: its lava sea's texture (gfx_ar_hooks.h gArLavaTexture) */
+extern ALIGNED8 Texture bowser_2_seg7_texture_07000000[];
+const void *gArLavaTexture = bowser_2_seg7_texture_07000000;
+static s32 sArLiquid = 0;   /* AR: GFX_AR_ROLE_WATER or _LAVA while a liquid list is appended, else 0 */
+/* AR: the liquid a generated list draws. Water: the water boxes' quads (not the three mists) and the water movtex
+ * quads (waterfalls, CotMC's stream); lava: LLL's and BitFS's lava movtex quads. The same parameter can mean another
+ * quad set for another geo function (moving_texture.h), so each function has its own list. */
+static s32 ar_liquid_role(const struct GraphNodeGenerated *node) {
+    const GraphNodeFunc f = node->fnNode.func;
+    const u32 p = node->parameter;
+    if (f == geo_movtex_draw_water_regions || f == geo_movtex_draw_water_regions_ext) {
+        if (p == HMC_MOVTEX_TOXIC_MAZE_MIST || p == SSL_MOVTEX_TOXBOX_QUICKSAND_MIST || p == JRB_MOVTEX_INTIAL_MIST) { return 0; }
+        return p == LLL_MOVTEX_VOLCANO_FLOOR_LAVA ? GFX_AR_ROLE_LAVA : GFX_AR_ROLE_WATER;
+    }
+    if (f == geo_movtex_draw_nocolor || f == geo_movtex_draw_colored || f == geo_movtex_draw_colored_no_update ||
+        f == geo_movtex_draw_colored_2_no_update) {
+        switch (p) {
+            case MOVTEX_LLL_LAVA_FLOOR: case MOVTEX_VOLCANO_LAVA_FALL:
+            case MOVTEX_BITFS_LAVA_FIRST: case MOVTEX_BITFS_LAVA_SECOND: case MOVTEX_BITFS_LAVA_FLOOR:
+                return GFX_AR_ROLE_LAVA;
+            case MOVTEX_CASTLE_WATERFALL: case MOVTEX_COTMC_WATER: case MOVTEX_TTM_BEGIN_WATERFALL: case MOVTEX_TTM_END_WATERFALL:
+            case MOVTEX_TTM_BEGIN_PUDDLE_WATERFALL: case MOVTEX_TTM_END_PUDDLE_WATERFALL: case MOVTEX_TTM_PUDDLE_WATERFALL:
+                return GFX_AR_ROLE_WATER;
+            default: break;
+        }
+    }
+    return 0;
+}
 /* AR: player i's own geometry is tagged for the x-ray silhouette; held objects and the shadow are not. */
 static u8 ar_focus_owner(void) {
     if (!gArMode || sArNoFocus || gCurGraphNodeHeldObject != NULL) { return 0; }
@@ -552,6 +583,7 @@ static void geo_process_master_list_sub(struct GraphNodeMasterList *node) {
     struct RenderModeContainer *mode2List = &renderModeTable_2Cycle[enableZBuffer];
     s32 arSpace = -1;
     s32 arFocus = 0;
+    s32 arRole = -1;
 
     // @bug This is where the LookAt values should be calculated but aren't.
     // As a result, environment mapping is broken on Fast3DEX2 without the
@@ -581,6 +613,10 @@ static void geo_process_master_list_sub(struct GraphNodeMasterList *node) {
                     gDPNoOpTag(gDisplayListHead++, GFX_AR_TAG(GFX_AR_TAG_FOCUS, currList->arFocus));
                     arFocus = currList->arFocus;
                 }
+                if (gArMode && currList->arRole != arRole) {
+                    gDPNoOpTag(gDisplayListHead++, GFX_AR_TAG(GFX_AR_TAG_ROLE, currList->arRole));
+                    arRole = currList->arRole;
+                }
                 detect_and_skip_mtx_interpolation(&currList->transform, &currList->transformPrev);
 
                 struct MtxInterp *interp = growing_array_alloc(sMtxTbl, sizeof(struct MtxInterp));
@@ -630,6 +666,9 @@ static void geo_append_display_list(void *displayList, s16 layer) {
         listNode->next = 0;
         listNode->usingCamSpace = sUsingCamSpace;
         listNode->arFocus = ar_focus_owner();
+        /* sArNoFocus is set exactly while a blob shadow list is appended (geo_process_shadow) */
+        listNode->arRole = sArNoFocus ? GFX_AR_ROLE_SHADOW : sArEffect ? GFX_AR_ROLE_EFFECT : sArLiquid ? (u8) sArLiquid
+                         : (gCurGraphNodeObject != NULL ? GFX_AR_ROLE_OBJECT : GFX_AR_ROLE_TERRAIN);
         if (gCurGraphNodeMasterList->listHeads[layer] == 0) {
             gCurGraphNodeMasterList->listHeads[layer] = listNode;
         } else {
@@ -1098,7 +1137,12 @@ static void geo_process_generated_list(struct GraphNodeGenerated *node) {
         Gfx *list = node->fnNode.func(GEO_CONTEXT_RENDER, &node->fnNode.node, gMatStack[gMatStackIndex]);
 
         if (list != NULL) {
+            /* AR: the weather particles (snow, underwater specks, flowers, lava bubbles) are effects, not terrain */
+            sArEffect = node->fnNode.func == geo_envfx_main;
+            sArLiquid = gArMode ? ar_liquid_role(node) : 0;   /* AR: a tag only: the list and its draws are vanilla's */
             geo_append_display_list((void *) VIRTUAL_TO_PHYSICAL(list), node->fnNode.node.flags >> 8);
+            sArEffect = FALSE;
+            sArLiquid = 0;
         }
     }
     if (node->fnNode.node.children != NULL) {
diff --git a/src/pc/gfx/gfx_ar_hooks.h b/src/pc/gfx/gfx_ar_hooks.h
index 76b68c6..30bec45 100644
--- a/src/pc/gfx/gfx_ar_hooks.h
+++ b/src/pc/gfx/gfx_ar_hooks.h
@@ -7,7 +7,17 @@
 /* G_NOOP tag word: "AR" in the high 16 bits, kind in bits 8..15, argument in bits 0..7. */
 #define GFX_AR_TAG_MAGIC 0x41520000u
 #define GFX_AR_TAG(kind, arg) (GFX_AR_TAG_MAGIC | (((uint32_t)(kind) & 0xFFu) << 8) | ((uint32_t)(arg) & 0xFFu))
-enum { GFX_AR_TAG_SPACE = 1, GFX_AR_TAG_GROUP_BEGIN = 2, GFX_AR_TAG_GROUP_END = 3, GFX_AR_TAG_FOCUS = 4 };
+enum { GFX_AR_TAG_SPACE = 1, GFX_AR_TAG_GROUP_BEGIN = 2, GFX_AR_TAG_GROUP_END = 3, GFX_AR_TAG_FOCUS = 4, GFX_AR_TAG_ROLE = 5 };
+/* ROLE tag argument: what the following display lists are (lighting). */
+enum { GFX_AR_ROLE_TERRAIN = 0, GFX_AR_ROLE_OBJECT = 1, GFX_AR_ROLE_SHADOW = 2, GFX_AR_ROLE_EFFECT = 3 };
+enum { GFX_AR_ROLE_WATER = 5, GFX_AR_ROLE_LAVA = 6 };
+/* with gArMode, TERRAIN draws that load this texture image are drawn with the LAVA role, until the next texture image
+ * or ROLE tag: Bowser in the Fire Sea's arena draws its lava sea inside a static list (not a movtex), next to its spike
+ * posts, and the game keeps the lists as heap copies, so the texture is what names the sea. Defined by the game
+ * (rendering_graph_node.c); NULL = none. */
+extern const void *gArLavaTexture;
+/* material() flags of WORLD triangles: the geometry mode they were lit with. */
+enum { GFX_AR_MAT_LIT = 1, GFX_AR_MAT_TEXGEN = 2 };
 enum { GFX_AR_SPACE_SCREEN = 0, GFX_AR_SPACE_WORLD = 1, GFX_AR_SPACE_DISCARD = 2 };
 enum { GFX_AR_CULL_NONE = 0, GFX_AR_CULL_BACK = 1, GFX_AR_CULL_FRONT = 2 };
 enum { GFX_AR_GROUP_MISC = 1, GFX_AR_GROUP_COUNTERS = 2, GFX_AR_GROUP_POWER_METER = 3,
@@ -18,6 +28,8 @@ struct GfxArHooks {
     void (*set_cull)(int cull);         /* GFX_AR_CULL_*, WORLD only, after a flush */
     void (*group)(int begin, int id);   /* overlay group BEGIN (1) / END (0), after a flush */
     void (*focus)(int owner);           /* FOCUS tag: 0, or player index + 1 (x-ray silhouette owner), after a flush */
+    void (*role)(int role);             /* ROLE tag: GFX_AR_ROLE_*, after a flush */
+    void (*material)(int flags);        /* GFX_AR_MAT_* of the next WORLD triangles, after a flush; reset each frame */
 };
 extern struct GfxArHooks *gGfxArHooks;   /* NULL = upstream behaviour */
 extern bool gArMode;
@@ -30,4 +42,7 @@ extern bool gArCannonVisible;
 /* Lighting camera: rotation used for lights and texgen of WORLD draws. */
 void gfx_ar_set_shading_view(const float m[4][4]);
 void gfx_ar_clear_shading_view(void);
+/* Light view: the rotation used for the lights (not texgen) of WORLD draws; overrides the shading view for lights. */
+void gfx_ar_set_light_view(const float m[4][4]);
+void gfx_ar_clear_light_view(void);
 #endif
