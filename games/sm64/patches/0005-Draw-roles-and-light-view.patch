+static int sArRole = GFX_AR_ROLE_TERRAIN;
+static bool sArLavaTex = false;
+
 static void gfx_ar_noop(uintptr_t w1) {
     if (gGfxArHooks == NULL || (w1 >> 16) != (GFX_AR_TAG_MAGIC >> 16)) { return; }
     uint32_t kind = (uint32_t)(w1 >> 8) & 0xFFu, arg = (uint32_t)w1 & 0xFFu;
@@ -1868,6 +1886,9 @@ static void gfx_ar_noop(uintptr_t w1) {
         if (gGfxArHooks->group) { gGfxArHooks->group(kind == GFX_AR_TAG_GROUP_BEGIN, (int)arg); }
