diff --git a/src/pc/platform.h b/src/pc/platform.h
index e043c6a..e16ebf5 100644
--- a/src/pc/platform.h
+++ b/src/pc/platform.h
@@ -29,6 +29,9 @@ bool sys_windows_short_path_from_mbs(char* destPath, size_t destSize, const char
 #endif
 const char *sys_user_path(void);
 const char *sys_resource_path(void);
+/* AR (0002-Library-seams-and-host-hooks.patch): when set, sys_resource_path() returns this directory (lang/, mods/, dynos/, palettes/). A visionOS
+ * app bundle is flat, with no ../Resources next to the executable. NULL keeps the upstream lookup. */
+extern const char *gArResourcePathOverride;
 const char *sys_exe_path_dir(void);
 const char *sys_exe_path_file(void);
 const char *sys_file_extension(const char *fpath);
